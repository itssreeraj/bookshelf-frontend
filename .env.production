# Copy this to .env.production and fill in your real deployed Koyeb URL.
#
# Vite automatically loads .env.production (over .env) whenever you run
# `npm run build` (production mode) -- which is what both the deployed web
# app AND the Android build (via `npm run android:sync`) use under the hood.
# So this one file keeps both in sync with your real backend, while `.env`
# stays pointed at localhost for `npm run dev`.
# VITE_API_BASE_URL=https://your-app-name.koyeb.app
VITE_API_BASE_URL=http://localhost:8080
